{
  "manifest_version": 3,
  "name": "GetRida.Work",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@getrida.work",
      "strict_min_version": "112.0"
    }
  },
  "version": "0.1.0",
  "description": "Compile your tabs into mission reports. Close the noise. Upgrade to full workspace agent.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://getrida.work/*"
  ],
  "action": {
    "default_title": "GetRida.Work"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "GetRida.Work"
  }
}